rules_version = '2';

// All reads and writes go through the Cloud Function, which talks to Firestore
// via the Admin SDK -- that always bypasses these rules. This file only
// controls *direct* client access (e.g. someone pointing a Firestore client
// SDK at this project with a public API key), which we don't want, so it's
// locked to fully closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
